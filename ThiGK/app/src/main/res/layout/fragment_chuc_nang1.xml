<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F5F5"
    tools:context=".ChucNang1Fragment">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TÍNH HÌNH CHỮ NHẬT"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        android:gravity="center"
        android:layout_marginBottom="32dp"
        android:layout_marginTop="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chiều dài (a):"
        android:textSize="16sp"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/edtChieuDai"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Nhập chiều dài"
        android:inputType="numberDecimal"
        android:background="@android:drawable/editbox_background"
        android:padding="10dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chiều rộng (b):"
        android:textSize="16sp"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/edtChieuRong"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:hint="Nhập chiều rộng"
        android:inputType="numberDecimal"
        android:background="@android:drawable/editbox_background"
        android:padding="10dp"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/btnChuVi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tính Chu Vi"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#4CAF50"/>

        <Button
            android:id="@+id/btnDienTich"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tính Diện Tích"
            android:layout_marginStart="8dp"
            android:backgroundTint="#FF9800"/>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kết quả:"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvKetQua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chưa có kết quả"
        android:textSize="20sp"
        android:textColor="#E91E63"
        android:gravity="center"
        android:padding="16dp"
        android:background="#E0E0E0"/>

</LinearLayout>